# ─────────────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
.installed.cfg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / lint / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ─────────────────────────────────────────────────────────────
# Node / frontend (Vue 3 + Vite)
# ─────────────────────────────────────────────────────────────
node_modules/
.npm/
.eslintcache
.vite/
*.local

# Built SPA — regenerated by ``npm run build`` (served by Flask).
# Comment this out if you want a clone to run without a build step.
frontend/dist/

# ─────────────────────────────────────────────────────────────
# Application data (data/) and logs (logs/) ARE committed by choice
# (e.g. to ship a seeded app.db). Only transient SQLite sidecar locks
# and the throwaway preview DB used for isolated testing are excluded.
# NOTE: data/app.db carries account rows + salted password hashes —
# committing it publishes those; rotate seed credentials before pushing.
# ─────────────────────────────────────────────────────────────
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/_preview.db
# Lab feature runtime artefacts — generated on the fly, not source.
data/sync_failures/
logs/sync.log*

# ─────────────────────────────────────────────────────────────
# Bundled adb — keep the source package (resources/re_adb/), but
# ignore the platform-tools released on first boot (regenerated by
# services/adb_bootstrap.py) and any extracted run path.
# ─────────────────────────────────────────────────────────────
resources/runpath/

# ─────────────────────────────────────────────────────────────
# Secrets / local env
# ─────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─────────────────────────────────────────────────────────────
# Editors / IDEs
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code workspace — not part of the project
.claude/

# Backend test suite — excluded from the published repo by choice
/tests/

# ─────────────────────────────────────────────────────────────
# OS cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─────────────────────────────────────────────────────────────
# Scratch / temp files
# ─────────────────────────────────────────────────────────────
tmp_*.py
*.tmp
*.bak
